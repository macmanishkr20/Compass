# Estimator — copy to .env and fill in. The variable names keep the
# COMPASS_ prefix on purpose: the settings code is Compass's, unchanged, and
# renaming the prefix would be a rewrite of config.py for no gain. Rename it
# the day that file is trimmed, not before.

# The model gateway. Without an endpoint the app starts and every screen
# works; the three generative steps answer 501 and say what is missing.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Where estimates are kept. `local` writes JSON under ./data and needs no
# Azure at all — the right setting for a laptop and for CI.
COMPASS_STORAGE_BACKEND=local
# AZURE_COSMOS_ENDPOINT=
# AZURE_COSMOS_KEY=
# AZURE_STORAGE_CONNECTION_STRING=

# Who may sign in. Comma-separated user:password pairs.
COMPASS_AUTH_ENABLED=1
COMPASS_AUTH_USERS=admin:change-me

# Optional
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# ESTIMATOR_LOG_LEVEL=INFO
